<div class="container mx-auto w-3/5 bg-white bg-opacity-70 p-6 mt-10 rounded-lg">
  <div class="w-fit mx-auto mt-12">
    <h1 class="font-bad text-4xl font-semibold text-secondary">Start to Reset Password</h1>
  </div>
  <div class="container mx-auto w-2/3 my-16">
    <%= form_with url: password_resets_path, local: true do |form| %>
      <div class="field">
        <%= form.label :email, User.human_attribute_name(:email), class: 'text-info' %>
        <%= form.email_field :email, class: 'input input-bordered input-sm w-full my-3' %>
      </div>
      <div class="actions">
        <%= form.submit t('password_resets.new.submit'), class:'btn btn-primary' %>
      </div>
    <% end %>
  </div>
</div>
